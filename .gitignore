# Build output
battle/build/
battle/fheroes2-battle
battle/fheroes2-relay
battle/build.log
*.zip

# Game assets extracted from the original installer by setup.sh. These are copyrighted game data,
# not ours to redistribute, and are reproducible from your own copy of the game.
battle/anim/
battle/data/
battle/maps/
battle/music/
battle/files/

# Runtime state written next to the binary
battle/fheroes2.cfg
battle/fheroes2.key
battle/save/

# The original game installer, and the bonus soundtrack archive. Both are yours, large, and
# reproducible from your own GOG library.
*.exe
*ost*.zip

# Editor and tooling
.vscode/
.omc/

# Python
__pycache__/
*.pyc
harness/journal.jsonl
harness/relay/

# Battle logs, wherever they are put and whatever they are named. They are recordings of a
# particular run, reproducible by fighting the scenario again, and they grow without bound.
battle-log*.jsonl
*.log
